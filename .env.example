# Copy this file to ".env" and change the values if needed.
# Never put real passwords in this file. It is saved in Git.

# The port the database uses on your PC.
# If 5432 is already used (for example by another PostgreSQL), use 5433.
POSTGRES_PORT=5432

# How the backend connects to the database:
# postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://supportdesk:supportdesk@localhost:5432/supportdesk

# Backend
PORT=4000

# Secret key used to sign login tokens. Make your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# AI: "mock" (fake AI, no key needed) or "gemini" (real AI, needs a key)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
